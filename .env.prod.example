# Public hostname. Point this and livekit.<domain> at the production server.
DOMAIN=roobro.ir

# GitHub Container Registry images built by .github/workflows/build-push.yml.
# IMAGE_TAG=latest follows main; use a short commit SHA for exact deploys.
REGISTRY=ghcr.io/4h1r
IMAGE_TAG=latest

# These credentials are shared by the API and LiveKit. Replace both values.
LIVEKIT_API_KEY=CHANGE_ME_KEY
LIVEKIT_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional loopback/public port overrides.
# FRONTEND_PORT=8081
# API_PORT=8080
# LIVEKIT_SIGNAL_PORT=7880
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_PORT=7882
