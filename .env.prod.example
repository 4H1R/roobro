# GitHub Container Registry images built by .github/workflows/build-push.yml.
# IMAGE_TAG=latest follows main; use a short commit SHA for exact deploys.
REGISTRY=ghcr.io/4h1r
IMAGE_TAG=latest
# CADDY_IMAGE=caddy:2.11.4-alpine
# LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6

# Browser-facing origins. Use http://<server-ip> and ws://<server-ip>:7880 for
# an initial domainless smoke test, then switch both to HTTPS/WSS for real use.
FRONTEND_URL=https://meet.example.com
LIVEKIT_PUBLIC_URL=wss://livekit.example.com

# Shared API/LiveKit credentials. Replace both values; never commit the result.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The HTTP gateway is loopback-only by default for a host TLS proxy. Set its
# address to 0.0.0.0 for a domainless deployment reachable on APP_PORT.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081

# LiveKit signaling is loopback-only when a host TLS proxy provides WSS.
# Set 0.0.0.0 when browsers connect directly to ws://<server-ip>:7880.
LIVEKIT_SIGNAL_BIND_ADDRESS=127.0.0.1
# LIVEKIT_SIGNAL_PORT=7880
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_PORT=7882
