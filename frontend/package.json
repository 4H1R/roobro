{
  "name": "@roobro/web",
  "private": true,
  "homepage": "https://roobro.ir",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build && bun scripts/prerender.mjs",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "seo:check": "bun run build && bun scripts/check-seo.mjs",
    "test": "vitest run",
    "brand:generate": "node scripts/generate-brand.mjs"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/router-plugin": "^1.168.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.3.4",
    "livekit-client": "^2.22.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "8.1.3",
    "vitest": "^4.1.11"
